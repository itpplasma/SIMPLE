function(download_nonempty_file url destination)
    if(EXISTS "${destination}")
        file(SIZE "${destination}" cached_size)
        if(cached_size GREATER 0)
            return()
        endif()
        file(REMOVE "${destination}")
    endif()
    file(DOWNLOAD "${url}" "${destination}" STATUS download_status)
    list(GET download_status 0 download_code)
    if(download_code EQUAL 0)
        file(SIZE "${destination}" downloaded_size)
        if(downloaded_size GREATER 0)
            return()
        endif()
    endif()
    file(REMOVE "${destination}")
    message(FATAL_ERROR "Required download failed or was empty: ${url}: ${download_status}")
endfunction()
