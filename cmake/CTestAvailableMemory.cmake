include_guard(GLOBAL)

# Missing, unlimited and out-of-range counters do not constrain the budget.
function(_simple_read_memory_counter output path)
    set(value "")
    if(EXISTS "${path}")
        file(READ "${path}" value)
        string(STRIP "${value}" value)
        string(LENGTH "${value}" length)
        if(NOT value MATCHES "^[0-9]+$" OR length GREATER 19 OR
           (length EQUAL 19 AND value STRGREATER "9223372036854775807"))
            set(value "")
        endif()
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_simple_cgroup_headroom output root path limit_file usage_file)
    set(${output} "" PARENT_SCOPE)
    get_filename_component(directory "${root}${path}" ABSOLUTE)
    # A cgroup namespace can name ancestors outside the visible mount.
    string(FIND "${directory}/" "${root}/" prefix)
    if(NOT prefix EQUAL 0)
        return()
    endif()
    _simple_read_memory_counter(usage "${directory}/${usage_file}")
    if(usage STREQUAL "")
        return()
    endif()
    set(limit "")
    while(TRUE)
        _simple_read_memory_counter(candidate "${directory}/${limit_file}")
        # v1 uses a page-aligned LONG_MAX sentinel for unlimited memory.
        if(limit_file STREQUAL "memory.limit_in_bytes" AND
           NOT candidate STREQUAL "" AND candidate GREATER_EQUAL 1152921504606846976)
            set(candidate "")
        endif()
        if(NOT candidate STREQUAL "")
            if(limit STREQUAL "" OR candidate LESS limit)
                set(limit "${candidate}")
            endif()
        endif()
        if(directory STREQUAL root)
            break()
        endif()
        get_filename_component(directory "${directory}" DIRECTORY)
    endwhile()
    if(NOT limit STREQUAL "")
        math(EXPR headroom "${limit} - ${usage}")
        if(headroom LESS 0)
            set(headroom 0)
        endif()
        set(${output} "${headroom}" PARENT_SCOPE)
    endif()
endfunction()

# Roots are arguments so the parser can be checked with synthetic Linux trees.
function(simple_test_available_memory output proc_root cgroup_root)
    set(mem_available "")
    if(EXISTS "${proc_root}/meminfo")
        file(STRINGS "${proc_root}/meminfo" mem_available REGEX "^MemAvailable:")
    endif()
    if(mem_available MATCHES "^MemAvailable:[ \t]*([0-9]+)[ \t]+kB")
        math(EXPR available "${CMAKE_MATCH_1} * 1024")
    else()
        cmake_host_system_information(RESULT mem_mib QUERY AVAILABLE_PHYSICAL_MEMORY)
        math(EXPR available "${mem_mib} * 1048576")
    endif()

    if(EXISTS "${proc_root}/self/cgroup")
        file(STRINGS "${proc_root}/self/cgroup" cgroups)
        foreach(cgroup IN LISTS cgroups)
            set(headroom "")
            if(cgroup MATCHES "^0::(/.*)$")
                _simple_cgroup_headroom(headroom "${cgroup_root}" "${CMAKE_MATCH_1}"
                    memory.max memory.current)
            elseif(cgroup MATCHES "^[0-9]+:([^:]+):(/.*)$")
                set(controllers ",${CMAKE_MATCH_1},")
                set(path "${CMAKE_MATCH_2}")
                if(controllers MATCHES ",memory,")
                    _simple_cgroup_headroom(headroom "${cgroup_root}/memory" "${path}"
                        memory.limit_in_bytes memory.usage_in_bytes)
                endif()
            endif()
            if(NOT headroom STREQUAL "" AND headroom LESS available)
                set(available "${headroom}")
            endif()
        endforeach()
    endif()

    # Slurm reports memory in MiB. Zero means no memory limit.
    if("$ENV{SLURM_MEM_PER_NODE}" MATCHES "^[0-9]+$")
        math(EXPR slurm_bytes "$ENV{SLURM_MEM_PER_NODE} * 1048576")
        if(slurm_bytes GREATER 0 AND slurm_bytes LESS available)
            set(available "${slurm_bytes}")
        endif()
    endif()
    if("$ENV{SLURM_MEM_PER_CPU}" MATCHES "^[0-9]+$" AND
       "$ENV{SLURM_CPUS_ON_NODE}" MATCHES "^[0-9]+$")
        math(EXPR slurm_bytes
            "$ENV{SLURM_MEM_PER_CPU} * $ENV{SLURM_CPUS_ON_NODE} * 1048576")
        if(slurm_bytes GREATER 0 AND slurm_bytes LESS available)
            set(available "${slurm_bytes}")
        endif()
    endif()
    set(${output} "${available}" PARENT_SCOPE)
endfunction()
