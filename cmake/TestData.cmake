# Test data from the web, pinned by URL and SHA-256. A transient server error
# is retried; a failed or altered download stops the configure step here
# instead of leaving a missing or truncated file for a later test to trip on.
set(SIMPLE_SIMSOPT_TEST_FILES
    "https://raw.githubusercontent.com/hiddenSymmetries/simsopt/912bdcc729d95433518c71df82b8cc45287908b3/tests/test_files")

function(simple_fetch_test_data url file sha256)
    if(EXISTS "${file}")
        file(SHA256 "${file}" actual)
        if(actual STREQUAL sha256)
            return()
        endif()
        message(STATUS "Refetching ${file}: SHA-256 ${actual} differs from ${sha256}")
    endif()
    get_filename_component(dir "${file}" DIRECTORY)
    file(MAKE_DIRECTORY "${dir}")
    set(part "${file}.part")
    foreach(attempt RANGE 1 5)
        file(DOWNLOAD "${url}" "${part}" STATUS status TIMEOUT 300 INACTIVITY_TIMEOUT 60)
        list(GET status 0 code)
        if(code EQUAL 0)
            file(SHA256 "${part}" actual)
            if(actual STREQUAL sha256)
                file(RENAME "${part}" "${file}")
                return()
            endif()
            set(status "SHA-256 ${actual}, expected ${sha256}")
        endif()
        message(STATUS "Fetching ${url} failed (attempt ${attempt}): ${status}")
        math(EXPR pause "10 * ${attempt}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep ${pause})
    endforeach()
    file(REMOVE "${part}")
    message(FATAL_ERROR "Cannot fetch test data ${url} to ${file}: ${status}")
endfunction()
