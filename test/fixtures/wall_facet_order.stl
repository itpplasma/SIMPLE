solid facet_order
  facet normal 0 0 0
    outer loop
      vertex 10 0 0
      vertex 11 0 0
      vertex 12 0 0
    endloop
  endfacet
  facet normal 0 0 0
    outer loop
      vertex 10 0 1
      vertex 11 0 1
      vertex 10 1 1
    endloop
  endfacet
  facet normal 0 0 0
    outer loop
      vertex 10 0 1
      vertex 11 0 1
      vertex 10 1 1
    endloop
  endfacet
  facet normal 0 0 0
    outer loop
      vertex 10 0 1
      vertex 11 0 1
      vertex 10 0 2
    endloop
  endfacet
  facet normal 0 0 0
    outer loop
      vertex 1 0 0
      vertex 1 1 0
      vertex 1 0 1
    endloop
  endfacet
endsolid facet_order
