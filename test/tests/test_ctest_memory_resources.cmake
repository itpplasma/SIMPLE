cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/CTestAvailableMemory.cmake")

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(scratch "${CMAKE_CURRENT_BINARY_DIR}/ctest-memory-${suffix}")
set(proc "${scratch}/proc")
set(cgroup "${scratch}/sys/fs/cgroup")
file(MAKE_DIRECTORY "${proc}/self" "${cgroup}")
file(WRITE "${proc}/meminfo" "MemTotal: 134217728 kB\nMemAvailable: 67108864 kB\n")
unset(ENV{SLURM_MEM_PER_NODE})
unset(ENV{SLURM_MEM_PER_CPU})
unset(ENV{SLURM_CPUS_ON_NODE})

function(write_gib path gib)
    math(EXPR bytes "${gib} * 1073741824")
    file(WRITE "${path}" "${bytes}\n")
endfunction()

function(check_memory description expected_gib)
    simple_test_available_memory(actual "${proc}" "${cgroup}")
    math(EXPR expected "${expected_gib} * 1073741824")
    if(NOT actual EQUAL expected)
        message(FATAL_ERROR "${description}: expected ${expected} bytes, got ${actual}")
    endif()
    message(STATUS "Verified: ${description}: ${expected_gib} GiB")
endfunction()

check_memory("missing cgroup membership" 64)
file(WRITE "${proc}/self/cgroup" "0::/batch/job\n")
check_memory("missing cgroup counters" 64)

file(MAKE_DIRECTORY "${cgroup}/batch/job")
file(WRITE "${cgroup}/memory.max" "max\n")
write_gib("${cgroup}/batch/memory.max" 48)
file(WRITE "${cgroup}/batch/job/memory.max" "max\n")
write_gib("${cgroup}/batch/job/memory.current" 8)
write_gib("${cgroup}/batch/memory.current" 20)
check_memory("v2 finite ancestor minus job usage, not ancestor usage" 40)
write_gib("${cgroup}/memory.max" 32)
check_memory("v2 includes mount root limit" 24)
write_gib("${cgroup}/batch/job/memory.max" 16)
check_memory("v2 tighter leaf limit" 8)
write_gib("${cgroup}/batch/job/memory.current" 20)
check_memory("v2 usage above effective limit clamps to zero" 0)
file(REMOVE "${cgroup}/batch/job/memory.current")
check_memory("missing usage falls back to MemAvailable" 64)
write_gib("${cgroup}/batch/job/memory.current" 1)
foreach(path IN ITEMS "" /batch /batch/job)
    file(WRITE "${cgroup}${path}/memory.max" "max\n")
endforeach()
check_memory("v2 all unlimited" 64)
write_gib("${cgroup}/batch/job/memory.max" 128)
check_memory("MemAvailable smaller than cgroup headroom" 64)
file(WRITE "${cgroup}/batch/job/memory.max" "invalid\n")
check_memory("malformed limit ignored" 64)

file(WRITE "${proc}/self/cgroup" "0::/\n")
write_gib("${cgroup}/memory.max" 12)
write_gib("${cgroup}/memory.current" 2)
check_memory("v2 namespace root membership" 10)
file(WRITE "${proc}/self/cgroup" "0::/../../invisible\n")
check_memory("invisible namespace ancestors ignored" 64)

file(WRITE "${proc}/self/cgroup"
    "3:cpu,cpuacct:/other\n5:cpuset,memory:/batch/job\n0::/unified\n")
file(MAKE_DIRECTORY "${cgroup}/memory/batch/job")
file(WRITE "${cgroup}/memory/memory.limit_in_bytes" "9223372036854771712\n")
write_gib("${cgroup}/memory/batch/memory.limit_in_bytes" 24)
write_gib("${cgroup}/memory/batch/job/memory.limit_in_bytes" 32)
write_gib("${cgroup}/memory/batch/job/memory.usage_in_bytes" 3)
check_memory("v1 memory controller, nested limit and job usage" 21)
file(WRITE "${cgroup}/memory/batch/memory.limit_in_bytes" "9223372036854771712\n")
file(WRITE "${cgroup}/memory/batch/job/memory.limit_in_bytes" "18446744073709551615\n")
check_memory("v1 unlimited sentinels ignored without overflow" 64)

set(ENV{SLURM_MEM_PER_NODE} 12288)
check_memory("Slurm per-node MiB cap" 12)
set(ENV{SLURM_MEM_PER_CPU} 2048)
set(ENV{SLURM_CPUS_ON_NODE} 4)
check_memory("Slurm per-CPU times allocated CPUs" 8)
set(ENV{SLURM_MEM_PER_NODE} 4096)
check_memory("smaller Slurm node cap wins" 4)
set(ENV{SLURM_MEM_PER_NODE} 0)
set(ENV{SLURM_CPUS_ON_NODE} 96)
check_memory("zero node cap and larger CPU cap ignored" 64)
set(ENV{SLURM_CPUS_ON_NODE} invalid)
check_memory("invalid CPU count ignored" 64)
unset(ENV{SLURM_CPUS_ON_NODE})
check_memory("missing CPU count ignored" 64)
set(ENV{SLURM_MEM_PER_NODE} invalid)
check_memory("invalid node cap ignored" 64)
unset(ENV{SLURM_MEM_PER_NODE})
file(WRITE "${proc}/self/cgroup" "0::/\n")
set(ENV{SLURM_MEM_PER_NODE} 16384)
check_memory("smaller cgroup headroom wins over Slurm cap" 10)

# With no proc tree, the portable host query must still give a numeric result.
unset(ENV{SLURM_MEM_PER_NODE})
simple_test_available_memory(portable "${scratch}/absent" "${scratch}/absent")
if(NOT portable MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Portable available-memory fallback failed: ${portable}")
endif()
file(REMOVE_RECURSE "${scratch}")
message(STATUS "Verified: portable available-memory fallback")
